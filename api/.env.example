# Runtime environment label for logs and operational behavior.
APP_ENV=development
# Structured log level: DEBUG, INFO, WARN, ERROR.
LOG_LEVEL=INFO
# Enables only limited local text-parsing fallback for UTF-8 textual content when Docling fails.
# This does not allow TEI or LLM failures to degrade into fake embeddings or heuristic answers.
ENABLE_LOCAL_FALLBACKS=false
#
# When true, both api and worker fail startup if TEI or the configured LLM model are unreachable.
DEPENDENCY_STARTUP_CHECKS_ENABLED=true

# API bind host.
HTTP_HOST=0.0.0.0
# API bind port.
HTTP_PORT=8080
# Public API base URL used when building polling links.
HTTP_PUBLIC_BASE_URL=http://localhost:8080
# Maximum duration for reading an HTTP request.
HTTP_READ_TIMEOUT=15s
# Maximum duration for writing an HTTP response.
HTTP_WRITE_TIMEOUT=15s
# Keep-alive idle timeout.
HTTP_IDLE_TIMEOUT=60s
# Maximum accepted upload size in bytes.
HTTP_MAX_UPLOAD_SIZE_BYTES=26214400

# PostgreSQL DSN for both api and worker processes.
POSTGRES_DSN=postgres://knowledge_base_admin:pass123!@localhost:5432/knowledge_base?sslmode=disable
# Maximum pgx pool size.
POSTGRES_MAX_CONNS=10
# Minimum pgx pool size.
POSTGRES_MIN_CONNS=2

# How often the worker polls PostgreSQL for queued jobs.
WORKER_POLL_INTERVAL=3s
# Reserved worker batch size knob for batched polling logic.
WORKER_BATCH_SIZE=10

# Root directory for local original-file storage.
FILES_ROOT_DIR=./var/files

# Directory that contains startup-loaded LLM prompt templates.
PROMPTS_DIR=./prompts

# Base URL for the document parsing service.
DOCLING_BASE_URL=http://localhost:5001
# Base URL for the TEI embedding service.
TEI_BASE_URL=http://localhost:8081

# Logical provider label used for logs and future provider-specific routing.
# Current examples: deepseek, openrouter, local_vllm. The backend currently treats this as metadata, not behavior dispatch.
LLM_PROVIDER=deepseek
# API contract type used by the provider adapter.
# Currently supported values: openai_compatible.
LLM_API_TYPE=openai_compatible
# Base URL for the configured LLM provider.
LLM_PROVIDER_BASE_URL=https://api.deepseek.com
# Secret API key for the configured LLM provider.
LLM_PROVIDER_API_KEY=
# Chat model name used for query rewrite, answer generation, and contradiction judgement.
LLM_MODEL_NAME=deepseek-chat

# Default ingestion pipeline ID used when bootstrapping a new project's first active index config.
PROJECT_INDEX_DEFAULTS_INGESTION_PIPELINE_ID=1
# Default embedding pipeline ID used when bootstrapping a new project's first active index config.
PROJECT_INDEX_DEFAULTS_EMBEDDING_PIPELINE_ID=1
# Default embedding model name; must exist in embeddings.embedding_models.
PROJECT_INDEX_DEFAULTS_EMBEDDING_MODEL_NAME=Qwen3-Embedding-0.6B
# Default embedding dimensionality for newly bootstrapped project index configs.
PROJECT_INDEX_DEFAULTS_EMBEDDING_DIMENSION=1024
# Default parser name snapshot stored on new project index configs.
PROJECT_INDEX_DEFAULTS_PARSER_NAME=docling
# Optional parser version snapshot stored on new project index configs.
PROJECT_INDEX_DEFAULTS_PARSER_VERSION=
# Default chunking strategy snapshot stored on new project index configs.
PROJECT_INDEX_DEFAULTS_CHUNKING_STRATEGY=recursive
# Default chunk size snapshot stored on new project index configs.
PROJECT_INDEX_DEFAULTS_CHUNK_SIZE=1200
# Default chunk overlap snapshot stored on new project index configs.
PROJECT_INDEX_DEFAULTS_CHUNK_OVERLAP=200
# Default chunk unit snapshot stored on new project index configs.
PROJECT_INDEX_DEFAULTS_CHUNK_UNIT=characters
# Optional tokenizer name snapshot stored on new project index configs.
PROJECT_INDEX_DEFAULTS_TOKENIZER_NAME=

# Global default for whether RAG query rewriting is enabled when a project does not override it.
QUERY_REWRITE_DEFAULT_ENABLED=true
# Global default retrieval breadth when a project does not override it.
RAG_RETRIEVAL_TOP_K=8
# Global default number of retrieved chunks actually included in the answer prompt.
RAG_CONTEXT_TOP_N=4

# Global maximum allowed embedding distance for contradiction candidate pairs.
CONTRADICTION_MAX_DISTANCE=0.35
# Number of nearest target chunks to inspect per base chunk before distance filtering.
CONTRADICTION_TOP_K_PER_BASE_CHUNK=1
# Maximum number of contradiction candidate pairs evaluated by the LLM in a single job.
CONTRADICTION_MAX_PAIRS_PER_JOB=50
