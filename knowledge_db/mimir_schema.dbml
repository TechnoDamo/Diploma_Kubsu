Project mimir {
  database_type: 'PostgreSQL'
  Note: '''
  Mimir stores authoritative project, document, chunk, job, and analysis state in PostgreSQL.
  Qdrant stores dense and sparse vectors only. Object storage stores original files.
  '''
}

Table documents.embedding_models {
  id bigserial [pk]
  name text [not null]
  source text [not null]
  dimension integer [not null]
  distance_metric text [not null, note: "cosine | dot | euclid"]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (name, dimension) [unique]
  }
}

Table documents.projects {
  id bigserial [pk]
  name text [unique, not null]
  description text [not null, default: ""]
  general_context text [not null, default: "", note: "Editable project orientation/context for RAG and analysis prompts."]
  state text [not null, default: "active", note: "active | reindexing | deleting"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table documents.project_index_configs {
  id bigserial [pk]
  project_id bigint [not null, ref: > documents.projects.id]
  version integer [not null]
  is_active boolean [not null, default: false]
  embedding_model_id bigint [not null, ref: > documents.embedding_models.id]
  parser_name text [not null, default: "docling"]
  parser_version text
  chunking_strategy text [not null, default: "recursive"]
  chunk_size integer [not null, default: 1200]
  chunk_overlap integer [not null, default: 200]
  chunk_unit text [not null, default: "characters"]
  tokenizer_name text
  sparse_method text [not null, default: "bm25"]
  sparse_language text [not null, default: "russian", note: "russian | english | multi"]
  rag_dense_weight real [not null, default: 0.7]
  rag_sparse_weight real [not null, default: 0.3]
  rag_retrieval_top_k integer
  rag_context_top_n integer
  query_rewrite_enabled boolean
  contradiction_dense_weight real [not null, default: 1.0]
  contradiction_sparse_weight real [not null, default: 0.0]
  contradiction_top_k_per_base integer
  contradiction_max_distance real
  created_at timestamptz [not null, default: `now()`]
  activated_at timestamptz

  Indexes {
    (project_id, version) [unique]
    project_id
  }

  Note: "Partial unique index in SQL: one active config per project WHERE is_active."
}

Table documents.documents {
  id bigserial [pk]
  project_id bigint [not null, ref: > documents.projects.id]
  name text [not null]
  storage_key text [not null]
  size_bytes bigint [not null]
  mime_type text [not null]
  sha256 text [not null]
  status text [not null, default: "uploaded", note: "uploaded | processing | indexed | failed"]
  indexed_config_id bigint [ref: > documents.project_index_configs.id]
  summary text [not null, default: "", note: "Auto-generated by LLM and editable by user."]
  failure_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (project_id, status)
    project_id
  }
}

Table documents.chunks {
  id bigserial [pk, note: "Must be equal to the Qdrant point id."]
  document_id bigint [not null, ref: > documents.documents.id]
  project_id bigint [not null, ref: > documents.projects.id]
  index_config_id bigint [not null, ref: > documents.project_index_configs.id]
  chunk_order integer [not null]
  text text [not null]
  char_start integer [not null]
  char_end integer [not null]
  token_count integer
  page_number integer
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (document_id, chunk_order) [unique]
    project_id
    document_id
  }
}

Table documents.document_processing_jobs {
  id bigserial [pk]
  project_id bigint [not null, ref: > documents.projects.id]
  document_id bigint [ref: > documents.documents.id]
  kind text [not null, note: "ingest | reindex"]
  status text [not null, default: "queued", note: "queued | processing | completed | failed"]
  target_index_config_id bigint [not null, ref: > documents.project_index_configs.id]
  attempt_count integer [not null, default: 0]
  last_error text
  claimed_by text
  claimed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  Indexes {
    status
  }
}

Table analysis.analysis_jobs {
  id bigserial [pk]
  project_id bigint [not null, ref: > documents.projects.id]
  base_document_id bigint [not null, ref: > documents.documents.id]
  status text [not null, default: "queued", note: "queued | processing | completed | failed"]
  warning_message text
  error_message text
  results jsonb [note: "ContradictionResult[] from OpenAPI."]
  attempt_count integer [not null, default: 0]
  claimed_by text
  claimed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  Indexes {
    (project_id, status)
  }
}

Table analysis.analysis_job_targets {
  job_id bigint [not null, ref: > analysis.analysis_jobs.id]
  document_id bigint [not null, ref: > documents.documents.id]

  Indexes {
    (job_id, document_id) [pk]
  }
}
