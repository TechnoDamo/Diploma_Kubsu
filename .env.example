# ============================================
# Mimir — Интеллектуальная RAG-система
# Команда по умолчанию: make up
#   LLM и Embedding → cloud
#   Docling, Postgres, Qdrant → local
#   Object Storage → filesystem
#   Graylog → включен
# ============================================

# ============================================
# Основные параметры
# ============================================
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ALLOW_ORIGINS=*

# ============================================
# Порты всех контейнеров
# ============================================
FRONTEND_HOST_PORT=3001
FRONTEND_CONTAINER_PORT=3000
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
GRAYLOG_UI_HOST_PORT=19000
GRAYLOG_GELF_HOST_PORT=12201
GRAYLOG_SYSLOG_HOST_PORT=1514
GRAYLOG_EXTRA_HOST_PORT=5555

# ============================================
# Hugging Face
# ============================================
HUGGING_FACE_HUB_TOKEN=
HF_ENDPOINT=https://huggingface.co

# ============================================
# Реляционная база данных (PostgreSQL)
# ============================================
POSTGRES_USER=mimir
POSTGRES_PASSWORD=mimir
POSTGRES_DB=mimir_db
DATABASE_URL=postgresql+asyncpg://mimir:mimir@postgres:5432/mimir_db
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2

# ============================================
# Векторная база данных (Qdrant)
# ============================================
QDRANT_IMAGE=qdrant/qdrant:v1.12.0
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=mimir_project
QDRANT_ON_DISK_PAYLOAD=true

# ============================================
# Объектное хранилище
# ============================================
OBJECT_STORAGE_PROVIDER=local
FILES_ROOT_DIR=/app/storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=mimir-files
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=mimir-files
# S3_REGION=us-east-1

# ============================================
# LLM (cloud: DeepSeek API по умолчанию)
# ============================================
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=120
LLM_CTX_SIZE=2048
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=5
# Только для make up LLM=local:
LLM_PORT=8091
LLM_GPU_IMAGE=vllm/vllm-openai:v0.6.3
LLM_MODELS_DIR=${HOME}/.cache/huggingface/hub
LLM_HF_REPO=Qwen/Qwen2.5-0.5B-Instruct
LLM_DTYPE=bfloat16

# ============================================
# Embedding (cloud: RouterAI API по умолчанию)
# ============================================
# Важно: размерность векторов, которую возвращает эта модель, должна совпадать
# с PROJECT_INDEX_DEFAULTS_EMBEDDING_DIMENSION ниже. Если меняете модель,
# проверьте её dimension и переиндексируйте документы.
EMBEDDING_BASE_URL=https://routerai.ru/api/v1
EMBEDDING_API_KEY=
EMBEDDING_API_TYPE=openai_compatible
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_POOLING=mean
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_DELAY=5
# Только для make up EMBEDDING=local:
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.5
EMBEDDING_MODELS_DIR=${HOME}/.cache/huggingface/hub
EMBEDDING_HF_REPO=minishlab/potion-base-32M

# ============================================
# Docling (парсинг документов)
# ============================================
DOCLING_PORT=5001
DOCLING_BASE_URL=http://docling:5001
DOCLING_TIMEOUT_SECONDS=300

# ============================================
# Graylog (логирование)
# ============================================
GRAYLOG_ENABLED=true
GRAYLOG_HOST=graylog
GRAYLOG_PORT=12201

# ============================================
# Гибридный поиск — RAG (информационный)
# ============================================
RAG_DENSE_WEIGHT=0.7
RAG_SPARSE_WEIGHT=0.3
RAG_RETRIEVAL_TOP_K=5
RAG_CONTEXT_TOP_N=4

# ============================================
# Гибридный поиск — противоречия
# ============================================
CONTRADICTION_DENSE_WEIGHT=0.5
CONTRADICTION_SPARSE_WEIGHT=0.5
CONTRADICTION_TOP_K=5
CONTRADICTION_MAX_DISTANCE=0.3

# ============================================
# Sparse-векторы
# ============================================
SPARSE_VECTOR_ENABLED=true
SPARSE_MODEL=Qdrant/bm25

# ============================================
# Индексация (дефолты для новых проектов)
# ============================================
# Эти значения записываются в active index config проекта при создании.
# Уже загруженные документы автоматически не меняют размерность или модель:
# после смены модели нужен новый проект или переиндексация.
PROJECT_INDEX_DEFAULTS_EMBEDDING_MODEL_NAME=qwen/qwen3-embedding-4b
PROJECT_INDEX_DEFAULTS_EMBEDDING_DIMENSION=2560
PROJECT_INDEX_DEFAULTS_CHUNK_SIZE=1200
PROJECT_INDEX_DEFAULTS_CHUNK_OVERLAP=200

# ============================================
# Worker (фоновые задачи)
# ============================================
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=10

# ============================================
# Промпты
# ============================================
PROMPTS_DIR=/app/prompts

# ============================================
# Проверки при старте
# ============================================
DEPENDENCY_STARTUP_CHECKS_ENABLED=true

# ============================================
# Максимальный размер загружаемого файла (МБ)
# ============================================
UPLOAD_MAX_SIZE_MB=25

# ============================================
# Парсинг документов
# true = Docling, false = Python (PyPDF2)
# ============================================
USE_DOCLING=true
